
##
# Local git work tree gardening.
#
# Uses ASC.
# @link https://github.com/Paulmicha/asc
# @license Apache-2.0 license
# @see README.md
#

# ASC_APPS defaults: nested git repo(s) must be added here (defaults to 'site').
/site

# Excluded environment global variables and other files generated by ASC.
/.env
/.env-local*
/compose.yml
/compose.override.yml
/docker-compose.yml
/docker-compose.override.yml

# ASC upgrades from upstream.
*.asc-upstream-copy

# Legacy local debug scripts path (TODO 2026-09 : deprecate ?)
/scripts/asc/local/*
!/scripts/asc/local/README.md

# /data contents are gitignored by default.
/data/*

# ASC project instance generated data (cache, env vars, make targets, etc.)
!/data/asc
/data/asc/*
!/data/asc/README.md

# ASC core file sidecars.
!/data/cron
/data/cron/*
!/data/cron/README.md
!/data/db
/data/db/*
!/data/db/dumps
/data/db/dumps/*
!/data/db/dumps/local
/data/db/dumps/local/*
!/data/db/dumps/local/README.md
!/data/doc/
/data/doc/*
!/data/doc/fixtures/
!/data/doc/fonts/
!/data/host/
/data/host/*
!/data/host/local/
/data/host/local/*
!/data/host/local/README.md
!/data/instance/
/data/instance/*
!/data/instance/local/
/data/instance/local/*
!/data/instance/local/README.md
!/data/instance/remote/
/data/instance/remote/*
!/data/instance/remote/README.md
!/data/log
/data/log/*
!/data/log/README.md
!/data/test
/data/test/*
!/data/test/frozen
/data/test/frozen/*
!/data/test/frozen/local
/data/test/frozen/local/*
!/data/test/frozen/local/README.md
!/data/test/report
/data/test/report/*
!/data/test/report/local
/data/test/report/local/*
!/data/test/report/local/README.md
!/data/test/result
/data/test/result/*
!/data/test/result/local
/data/test/result/local/*
!/data/test/result/local/README.md
!/data/thread
/data/thread/*
!/data/thread/README.md
!/data/tmp
/data/tmp/*
!/data/tmp/README.md

# Misc.
nohup.out
docker-runtime
.idea
*.sql
.DS_Store
._*
.bash_aliases
*.sshconfig
__pycache__
*.py[cod]

# Wip: evalute OpenIDEA editor.
.openidea
