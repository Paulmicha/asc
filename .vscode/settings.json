{
  // Show .git in the explorer. The object store stays hidden.
  // `false` overrides the editor default that hides **/.git.
  "files.exclude": {
    "**/.git": false,
    "**/.git/objects": true
  },
  "files.watcherExclude": {
    "data": true
  },
  "search.exclude": {
    "data": true,
    ".git/objects": true
  }
}
